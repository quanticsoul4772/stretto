# Linux build artifacts
synth
synth.packed
synth_debug
*.dbg.o
*.dbg.d

# Windows build artifacts
stretto.exe
stretto.packed.exe
*.win.o

# Build-time generators and their generated headers
gen_sin_table
gen_env_table
gen_note_table
gen_euclid_table
gen_wavetable
# NOTE: the generated headers themselves are NOT ignored -- they are
# committed. Principle III depends on the table bytes being a fixed
# source of truth, and CI pins ubuntu-24.04 solely because build-time
# generation reads host libm. Committing them makes that claim true and
# turns silent per-host drift into a visible git diff. Only the generator
# BINARIES stay ignored (above).
version.h
version.h.tmp

# Object files
*.o

# Auto-generated header-dependency files (gcc -MMD)
*.d

# Coverage build
build_cov/
build_san/
synth_cov
*.gcda
*.gcno
*.gcov

# Unit-test binaries (glob + un-ignore sources: the old per-binary
# list silently missed newly added tests, e.g. test_midi)
tests/unit/test_*
!tests/unit/test_*.c
tests/unit/*.cov

# Editor backups
*.bak

# Test outputs (typically written to /tmp; included defensively)
/tmp/*.wav

# Stray working-tree docs (historical design doc re-extracted into the tree)
The 64KB Wotja - A Decision-Ready Plan for a Demoscene-Style Generative Music Player on Linux.md

# Agent scratch artifacts (PR bodies / commit messages drafted during
# spec-kit runs; the canonical copies live on the GitHub PRs / commits)
.specify/PR-*-body.md
.specify/commit_msg_*.txt
commit_msg*.txt

# One-off local measurement artifacts
synth.stripped
binary-sizes.txt

# Per-user Claude Code settings (machine-local permissions)
.claude/settings.local.json
